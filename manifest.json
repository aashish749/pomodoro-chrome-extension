{
  "manifest_version": 3,
  "name": "Pomodoro Chrome Extension",
  "version": "1.6",
  "description": "Tailored Pomodoro timer extension with customizable settings and hourly analytics.",
  "permissions": [
    "alarms",
    "storage",
    "offscreen",
    "declarativeNetRequest",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-checker.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "logo.png"
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["analytics.html", "audio.html"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": [
        "Badges(1).png",
        "streak (1).png",
        "badges/10hours_at_leastfor30days.png",
        "badges/14hoursdailyforamonth.png",
        "badges/bronze_medal_for_16hours_singledayshift.png",
        "badges/complete 6 hours without single pause.png",
        "badges/godlmedal_for_1000hours.png",
        "badges/musk_badge_for_100hours_plus_perweek.png",
        "badges/silverfor_3consecutive_16hours_days.png",
        "timeisabout_to_up.mp3",
        "completed.mp3"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
