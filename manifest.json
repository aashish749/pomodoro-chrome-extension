{
  "manifest_version": 3,
  "name": "Pomodoro Chrome Extension",
  "version": "1.5",
  "description": "Tailored Pomodoro timer extension with customizable settings and hourly analytics.",
  "permissions": [
    "alarms",
    "storage",
    "offscreen",
    "declarativeNetRequest",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-checker.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "logo.png"
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["analytics.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
